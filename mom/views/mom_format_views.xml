<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- MOM Format Tree View -->
    <record id="view_mom_format_tree" model="ir.ui.view">
        <field name="name">mom.format.base.tree</field>
        <field name="model">mom.format.base</field>
        <field name="arch" type="xml">
            <list string="MOM Format" decoration-success="state=='approved'" decoration-info="state=='completed'" decoration-warning="state=='in_progress'" decoration-danger="state=='cancelled'">
                <!-- <field name="sequence" widget="handle" optional="show"/> -->
                <field name="name"/>
                <field name="meeting_date"/>
                <field name="meeting_title"/>
                <field name="meeting_type"/>
                <field name="project_name"/>
                <field name="customer_id"/>
                <field name="conducted_by_id"/>
                <field name="state" widget="badge" decoration-success="state=='approved'" decoration-info="state=='completed'" decoration-warning="state=='in_progress'" decoration-danger="state=='cancelled'"/>
            </list>
        </field>
    </record>

    <!-- MOM Format Form View -->
    <record id="view_mom_format_form" model="ir.ui.view">
        <field name="name">mom.format.base.form</field>
        <field name="model">mom.format.base</field>
        <field name="arch" type="xml">
            <form string="MOM Format">
                <header>
                    <button name="action_in_progress" type="object" string="Start Progress" class="btn-primary" 
                            invisible="state != 'draft'" confirm="Are you sure you want to start progress on this record?"/>
                    <button name="action_complete" type="object" string="Mark as Completed" class="btn-primary" 
                            invisible="state != 'in_progress'" confirm="Are you sure you want to mark this as completed?"/>
                    <button name="action_approve" type="object" string="Approve" class="btn-success" 
                            invisible="state != 'completed'" confirm="Are you sure you want to approve this MOM?"/>
                    <button name="action_cancel" type="object" string="Cancel" 
                            invisible="state in ['approved', 'cancelled']" confirm="Are you sure you want to cancel this record?"/>
                    <button name="action_reset_to_draft" type="object" string="Reset to Draft" 
                            invisible="state == 'draft'" confirm="Are you sure you want to reset this record to draft?"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,completed,approved"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Approved" bg_color="bg-success" invisible="state != 'approved'"/>
                    <widget name="web_ribbon" title="Cancelled" bg_color="bg-danger" invisible="state != 'cancelled'"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                        <field name="meeting_title"/>
                        <field name="meeting_date"/>
                        <field name="meeting_type"/>
                        </group>
                        <group>
                        <field name="project_name"/>
                        <field name="customer_id"/>
                        <field name="conducted_by_id" widget="many2one_avatar_employee"/>
                        <field name="attendee_ids" widget="many2many_tags_avatar"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="MOM Lines">
                            <field name="mom_line_ids" context="{'default_mom_format_id': id, 'default_attendee_ids': attendee_ids, 'default_conducted_by_id': conducted_by_id}">
                                <list string="MOM Lines" editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="serial_no" readonly="1"/>
                                    <field name="open_point_id" required="1"/>
                                    <field name="responsibility_id"/>
                                    <field name="create_date" readonly="1" widget="date"  optional="show"/>
                                    <field name="target_date" required="1"/>
                                    <field name="actual_completion_date"/>
                                    <field name="remarks" optional="show"/>
                                    <field name="attendee_ids" widget="many2many_tags" optional="hide"/>
                                    <field name="conducted_by_id" optional="hide"/>
                                    <field name="state" widget="badge" 
                                            decoration-success="state=='approved'" 
                                            decoration-info="state=='completed'" 
                                            decoration-warning="state=='in_progress'" 
                                            decoration-danger="state=='cancelled'"/>
                                    <button name="action_in_progress" string="Start Progress" type="object" class="btn-sm btn-primary"  
                                            invisible="state != 'draft'" data-hotkey="p"/>
                                    <button name="action_complete" string="Complete" type="object" class="btn-sm btn-primary" 
                                            invisible="state != 'in_progress'" data-hotkey="c"/>
                                    <button name="action_approve" string="Approve" type="object" class="btn-sm btn-success" 
                                            invisible="state != 'completed'" data-hotkey="a"/>
                                    <button name="action_cancel" string="Cancel" type="object" 
                                            invisible="state not in ('draft', 'in_progress', 'completed')" data-hotkey="x"/>
                                    <button name="action_reset_to_draft" string="Reset to Draft" type="object" class="btn-sm btn-warning"
                                            invisible="state not in ('approved', 'cancelled')" data-hotkey="d"/>
                                    <button
                                        name="get_formview_action"
                                        type="object"
                                        string="Open"
                                        class="btn btn-info"
                                    />
                                    <field name="approve_date" invisible="state != 'approved'" optional="hide"/>
                                    <field name="approved_by_id" invisible="state != 'approved'" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <!-- <page string="Attendees">
                            <field name="attendee_ids" widget="many2many_tags_avatar"/>
                        </page> -->
                        <page string="Remarks">
                            <field name="remarks" nolabel="1" placeholder="Add your remarks here..."/>
                        </page>
                        <page string="Approval Info" invisible="state != 'approved'">
                            <group>
                                <field name="approved_by_id" readonly="1"/>
                                <field name="approve_date" readonly="1"/>
                            </group>
                        </page>
                        <page string="State History">
                            <field name="state_history" nolabel="1" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- MOM Format Search View -->
    <record id="view_mom_format_search" model="ir.ui.view">
        <field name="name">mom.format.base.search</field>
        <field name="model">mom.format.base</field>
        <field name="arch" type="xml">
            <search string="Search MOM Format">
                <field name="name"/>
                <field name="meeting_title"/>
                <field name="meeting_date"/>
                <field name="project_name"/>
                <field name="customer_id"/>
                <field name="conducted_by_id"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="In Progress" name="in_progress" domain="[('state', '=', 'in_progress')]"/>
                <filter string="Completed" name="completed" domain="[('state', '=', 'completed')]"/>
                <filter string="Approved" name="approved" domain="[('state', '=', 'approved')]"/>
                <separator/>
                <filter string="My Records" name="my_records" domain="[('conducted_by_id.user_id', '=', uid)]"/>
                <group expand="0" string="Group By">
                    <filter string="Meeting Type" name="group_meeting_type" context="{'group_by': 'meeting_type'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Meeting Date" name="group_meeting_date" context="{'group_by': 'meeting_date'}"/>
                    <filter string="Customer" name="group_customer" context="{'group_by': 'customer_id'}"/>
                    <filter string="Conducted By" name="group_conducted_by" context="{'group_by': 'conducted_by_id'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>
