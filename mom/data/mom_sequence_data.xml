<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sequence for MOM Format -->
        <record id="seq_mom_format" model="ir.sequence">
            <field name="name">MOM Format Sequence</field>
            <field name="code">mom.format.base</field>
            <field name="prefix">MOM/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
